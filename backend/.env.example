# Database connection string (defaults to local SQLite backend/awsense.db when unset)
DATABASE_URL=sqlite:///./awsense.db

# Example PostgreSQL connection string (install psycopg2-binary or psycopg first):
# DATABASE_URL=postgresql+psycopg2://awsense:awsense@localhost:5432/awsense

# Set to "true" to log generated SQL statements
SQL_ECHO=false

# Telemetry ingestion source: "mock" (30-day synthetic dataset) or "aws" (Boto3 read-only collectors)
DATA_SOURCE=mock

# AWS SDK configuration (used when DATA_SOURCE=aws)
AWS_REGION=us-east-1
# AWS_PROFILE=your-read-only-profile

# Optional LLM incident explanation keys (deterministic template fallback runs when unset or on errors)
# LLM_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated allowed CORS origins for FastAPI (defaults to "*" for local dev)
CORS_ORIGINS=*
