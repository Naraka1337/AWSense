# Frontend data mode toggle:
#   true  -> Offline Sample Mode (uses local mock fixtures in src/mock/, no backend required)
#   false -> Live Backend Mode (calls FastAPI via VITE_API_URL and transforms payloads via adapters.js)
VITE_USE_MOCK=true

# FastAPI backend base URL (Vite dev server proxies /api/* to http://localhost:8000 when using localhost)
VITE_API_URL=http://localhost:8000/api/v1
